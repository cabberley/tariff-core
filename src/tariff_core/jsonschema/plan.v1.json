              "pattern": "^(?:[Aa][Ll][Ll]|[Ww][Ee][Ee][Kk][Dd][Aa][Yy][Ss]|[Ww][Ee][Ee][Kk][Ee][Nn][Dd][Ss]|(?:[Mm][Oo][Nn]|[Tt][Uu][Ee]|[Ww][Ee][Dd]|[Tt][Hh][Uu]|[Ff][Rr][Ii]|[Ss][Aa][Tt]|[Ss][Uu][Nn]))$",
              "type": "string"
            },
            {
              "items": {
                "pattern": "^(?:[Mm][Oo][Nn]|[Tt][Uu][Ee]|[Ww][Ee][Dd]|[Tt][Hh][Uu]|[Ff][Rr][Ii]|[Ss][Aa][Tt]|[Ss][Uu][Nn])$",
